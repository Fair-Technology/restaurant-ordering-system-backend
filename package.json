{
  "name": "restaurant-ordering-system-backend",
  "version": "1.0.0",
  "description": "Azure Function App for Online Ordering System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && func start",
    "dev": "concurrently \"npm run build:watch\" \"nodemon --watch dist --exec \\\"npx kill-port 7071 && func start --port 7071\\\"\"",
    "build:watch": "tsc -w -p tsconfig.json",
    "start:dist": "func start --script-root dist --port 7073",
    "seed": "ts-node --transpile-only scripts/seed.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.5.1",
    "@azure/functions": "^4.0.0",
    "@azure/storage-blob": "^12.30.0",
    "@stripe/connect-js": "^3.3.34",
    "@stripe/react-connect-js": "^3.3.33",
    "axios": "^1.13.2",
    "jose": "^6.1.2",
    "openapi": "^1.0.0",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.9.1",
    "azure-functions-core-tools": "^4.0.0",
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.6"
  }
}
